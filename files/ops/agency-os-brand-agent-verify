#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

test "$(id -u)" -eq 0 || { echo "agency-os-brand-agent-verify must run as root" >&2; exit 77; }
# shellcheck disable=SC1091
. /opt/paperclip/integration/build/appliance.lock
test "$(git -C /opt/agency-os/current rev-parse HEAD)" = "$AGENCY_OS_COMMIT"
test "$(stat -c '%a:%U' /etc/agency-os/brand-agent.env)" = "600:root"
test "$(grep -Ec '^FLEET_BRAND_AGENT_(API_KEY|ACTION_SECRET)=[0-9a-f]{64}$' \
  /etc/agency-os/brand-agent.env)" -eq 2
test "$(stat -c '%a:%U' /var/lib/agency-os/fleet-brand-agent.sqlite3)" = "600:root"
systemctl is-enabled --quiet agency-os-brand-agent.service
systemctl is-active --quiet agency-os-brand-agent.service
ss -ltnH | awk '{print $4}' | grep -qx '127.0.0.1:3181'
health=$(curl --fail --silent --show-error --max-time 5 \
  http://127.0.0.1:3181/health)
jq -e '.status=="ok" and .brand_id=="brand_fleet" and
  .public_claim_count==7 and .external_model==false' <<<"$health" >/dev/null

proof=/var/lib/paperclip-appliance/fleet-brand-agent.json
test "$(stat -c '%a:%U' "$proof")" = "600:root"
company_id=$(tr -d '\n' </etc/paperclip/company-id)
jq -e --arg commit "$AGENCY_OS_COMMIT" --arg company "$company_id" '
  .schema_version=="1.0" and .status=="pass" and
  .agency_os_commit==$commit and .brand_id=="brand_fleet" and
  .company_id==$company and .public_claim_count==7 and
  .evaluation_statuses=={
    factual:"answered",unknown:"unknown",protected:"refused",injection:"refused"} and
  .mcp_tool_count==4 and .mcp_resource_count==3 and
  .controlled_action.status=="cancelled" and
  .controlled_action.external_write==false and
  .external_model==false and .provider_external_writes==false and
  .service_url=="http://127.0.0.1:3181"
' "$proof" >/dev/null

issue_id=$(jq -er '.controlled_action.paperclip_issue_id' "$proof")
task=$(/opt/paperclip/ops/paperclip-board-api GET "/issues/$issue_id")
jq -e --arg company "$company_id" '
  .companyId==$company and .status=="cancelled"
' <<<"$task" >/dev/null

jq -cn --arg commit "$AGENCY_OS_COMMIT" --argjson health "$health" \
  --arg proof_checksum "$(sha256sum "$proof" | awk '{print $1}')" \
  '{status:"pass",agency_os_commit:$commit,health:$health,
    proof_checksum:$proof_checksum,external_model:false,
    provider_external_writes:false}'
