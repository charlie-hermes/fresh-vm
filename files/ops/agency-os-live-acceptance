#!/usr/bin/python3
"""Run the approved fictional Agency OS workflow on real Paperclip and Buzz."""

from __future__ import annotations

import hashlib
import json
import os
import subprocess
import sys
import tempfile
import urllib.request
from datetime import datetime, timezone
from pathlib import Path


AGENCY_ROOT = Path("/opt/agency-os/current")
sys.path.insert(0, str(AGENCY_ROOT))

from agency_os.core_workflow import run_core_workflow
from agency_os.gateway import MockPublisher
from agency_os.integrations import (
    BuzzCliTransport,
    PaperclipBoardApprovalAdapter,
    PaperclipBoardHTTPTransport,
    PaperclipBrandBinding,
    PaperclipHTTPTransport,
    PaperclipLifecycleAdapter,
    TypedBuzzAdapter,
    _task_metadata,
)
from agency_os.social_workflow import SocialAmplifierDenied, run_social_workflow


def verify_completed_campaign(
    adapter: PaperclipLifecycleAdapter,
    tasks: list[dict[str, object]],
    section: dict[str, object],
    expected_count: int,
) -> None:
    approval_id = section.get("approval_id")
    campaign_id = section.get("campaign_id")
    if not isinstance(approval_id, str) or not isinstance(campaign_id, str):
        raise SystemExit("Core proof campaign identity is incomplete")
    approval = adapter.get_approval(approval_id)
    approval_tasks = adapter.get_approval_issues(approval_id)
    campaign_tasks = [
        item for item in tasks
        if _task_metadata(item).get("campaign_id") == campaign_id
    ]
    if (
        approval.get("status") != "approved"
        or section.get("approval_status") != "approved"
        or section.get("task_count") != expected_count
        or len(approval_tasks) != 1
        or approval_tasks[0].get("status") != "done"
        or len(campaign_tasks) != expected_count
        or not all(item.get("status") == "done" for item in campaign_tasks)
    ):
        raise SystemExit("Core proof campaign is no longer complete")


def load_env(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        values[key] = value.strip().strip("'\"")
    return values


def atomic_json(path: Path, value: dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    handle, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            json.dump(value, stream, indent=2, sort_keys=True)
            stream.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def paperclip_admin(
    base_url: str,
    token: str,
    method: str,
    path: str,
    payload: dict[str, object] | None = None,
) -> object:
    body = None if payload is None else json.dumps(payload).encode("utf-8")
    request = urllib.request.Request(
        f"{base_url}/api{path}", data=body, method=method,
        headers={"Accept": "application/json", "Content-Type": "application/json",
                 "Authorization": f"Bearer {token}"},
    )
    with urllib.request.urlopen(request, timeout=10) as response:
        return json.loads(response.read().decode("utf-8"))




def main() -> None:
    if os.geteuid() != 0:
        raise SystemExit("root required")
    operator = load_env(Path("/etc/paperclip/operator.env"))
    buzz_env = load_env(Path("/home/ubuntu/.config/buzz/bridge.env"))
    token = operator.get("PAPERCLIP_BOARD_API_KEY", "")
    relay = buzz_env.get("BUZZ_RELAY_URL", "")
    identity_path = Path(buzz_env.get("BUZZ_IDENTITY_FILE", ""))
    if not token or not relay or not identity_path.is_absolute():
        raise SystemExit("Paperclip or Buzz live credential is not configured")
    identity = json.loads(identity_path.read_text())
    private_key = identity.get("privateKeyHex", "")
    if not isinstance(private_key, str) or not private_key:
        raise SystemExit("Buzz private identity is incomplete")
    agent_ids = json.loads(Path("/etc/paperclip/hermes-agent-ids.json").read_text())
    agency_director_id = agent_ids.get("agency-director")
    if not isinstance(agency_director_id, str) or not agency_director_id:
        raise SystemExit("Agency Director is not registered in Paperclip")


    lock = load_env(Path("/opt/paperclip/integration/build/appliance.lock"))
    expected_buzz = lock["AGENCY_OS_BUZZ_SHA256"]
    observed_buzz = hashlib.sha256(Path("/usr/local/bin/buzz").read_bytes()).hexdigest()
    if observed_buzz != expected_buzz:
        raise SystemExit("Buzz binary checksum changed")
    commit = subprocess.run(
        ["git", "-C", str(AGENCY_ROOT), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if commit != lock["AGENCY_OS_COMMIT"]:
        raise SystemExit("Agency OS release commit changed")

    company_id = Path("/etc/paperclip/company-id").read_text().strip()
    brand_id = "brand_agency_live"
    binding = PaperclipBrandBinding(company_id, brand_id)
    base_url = f"http://{lock['PAPERCLIP_GATEWAY']}:{lock['PAPERCLIP_PORT']}"
    isolation_name = "Agency OS Isolation Acceptance"
    companies = paperclip_admin(base_url, token, "GET", "/companies")
    isolation_id = next(
        (item["id"] for item in companies if item.get("name") == isolation_name), None
    )
    if isolation_id is None:
        created = paperclip_admin(
            base_url, token, "POST", "/companies",
            {"name": isolation_name,
             "description": "Fictional two-brand isolation proof"},
        )
        isolation_id = created["id"]
    paperclip = PaperclipLifecycleAdapter(
        PaperclipHTTPTransport(base_url=base_url, bearer_token=token), binding
    )
    board = PaperclipBoardApprovalAdapter(
        PaperclipBoardHTTPTransport(base_url=base_url, bearer_token=token), binding
    )
    buzz = TypedBuzzAdapter(
        BuzzCliTransport(
            relay_url=relay,
            private_key_provider=lambda: private_key,
            executable="/usr/local/bin/buzz",
            timeout_seconds=30,
        ),
        brand_id,
    )

    isolation_binding = PaperclipBrandBinding(
        isolation_id, "brand_agency_isolation"
    )
    isolation_paperclip = PaperclipLifecycleAdapter(
        PaperclipHTTPTransport(base_url=base_url, bearer_token=token),
        isolation_binding,
    )
    isolation_board = PaperclipBoardApprovalAdapter(
        PaperclipBoardHTTPTransport(base_url=base_url, bearer_token=token),
        isolation_binding,
    )
    isolation_buzz = TypedBuzzAdapter(
        BuzzCliTransport(relay_url=relay, private_key_provider=lambda: private_key,
            executable="/usr/local/bin/buzz", timeout_seconds=30),
        "brand_agency_isolation",
    )
    evidence_path = Path("/var/lib/paperclip-appliance/agency-os-production.json")
    if evidence_path.is_file():
        previous = json.loads(evidence_path.read_text(encoding="utf-8"))
        if previous.get("status") == "live_production":
            if not (
                previous.get("schema_version") == "1.0"
                and previous.get("brand_id") == brand_id
                and previous.get("company_id") == company_id
                and previous.get("paperclip_authenticated") is True
                and previous.get("buzz_authenticated") is True
                and previous.get("provider_external_writes") is False
                and previous.get("mock_publication_calls") == 3
            ):
                raise SystemExit("previous Core production proof is unsafe")
            core_section = previous.get("core")
            social_section = previous.get("social")
            isolation_section = previous.get("isolation_brand")
            if not all(
                isinstance(item, dict)
                for item in (core_section, social_section, isolation_section)
            ):
                raise SystemExit("previous Core proof sections are incomplete")
            if (
                isolation_section.get("company_id") != isolation_id
                or isolation_section.get("brand_id") != "brand_agency_isolation"
                or isolation_section.get("cross_brand_social_denied") is not True
                or isolation_section.get("denial_created_tasks") is not False
                or isolation_section.get("paperclip_cost_event_recorded") is not False
            ):
                raise SystemExit("previous isolation proof changed")
            main_tasks = paperclip.list_tasks()
            isolation_tasks = isolation_paperclip.list_tasks()
            verify_completed_campaign(paperclip, main_tasks, core_section, 8)
            verify_completed_campaign(paperclip, main_tasks, social_section, 5)
            verify_completed_campaign(
                isolation_paperclip, isolation_tasks, isolation_section, 8
            )
            proof_origin = (
                previous.get("proof_origin_agency_os_commit")
                or previous.get("agency_os_commit")
            )
            if not isinstance(proof_origin, str) or len(proof_origin) != 40:
                raise SystemExit("Core proof origin commit is invalid")
            previous["proof_origin_agency_os_commit"] = proof_origin
            previous["reattested_existing_proof"] = True
            previous["agency_os_commit"] = commit
            previous["verified_at"] = datetime.now(timezone.utc).isoformat()
            atomic_json(evidence_path, previous)
            print("AGENCY OS LIVE ACCEPTANCE: PASS (RE-ATTESTED)")
            return
    def approve(requested: dict[str, object], _manifest: object) -> dict[str, object]:
        return board.decide_approval(
            str(requested["id"]),
            decision="approve",
            decision_note="Human owner approved this fictional production acceptance package.",
        )

    suffix = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")
    publisher = MockPublisher()
    def approve_isolation(
        requested: dict[str, object], _manifest: object
    ) -> dict[str, object]:
        return isolation_board.decide_approval(
            str(requested["id"]), decision="approve",
            decision_note="Human owner approved this fictional isolation package.",
        )


    core = run_core_workflow(
        paperclip=paperclip,
        buzz=buzz,
        approval_authority=approve,
        publisher=publisher,
        campaign_id=f"camp_live_{suffix}",
        asset_id=f"asset_live_{suffix}",
        brand_name="Agency OS Live Acceptance",
        product_tier="search_authority_social",
        cost_agent_id=agency_director_id,
    )
    social = run_social_workflow(
        core=core,
        paperclip=paperclip,
        buzz=buzz,
        approval_authority=approve,
        publisher=publisher,
        campaign_id=f"camp_live_social_{suffix}",
        asset_id=f"asset_live_social_{suffix}",
    )
    if any(item["status"] != "done" for item in core.tasks_by_role.values()):
        raise SystemExit("Core workflow did not close")
    if any(item["status"] != "done" for item in social.tasks_by_role.values()):
        raise SystemExit("Social workflow did not close")
    isolation_core = run_core_workflow(
        paperclip=isolation_paperclip,
        buzz=isolation_buzz,
        approval_authority=approve_isolation,
        publisher=publisher,
        campaign_id=f"camp_isolation_{suffix}",
        asset_id=f"asset_isolation_{suffix}",
        brand_name="Agency OS Isolation Brand",
        product_tier="search_authority_core",
        cost_agent_id=None,
    )
    before_denial = len(isolation_paperclip.list_tasks())
    try:
        run_social_workflow(
            core=core,
            paperclip=isolation_paperclip,
            buzz=isolation_buzz,
            approval_authority=approve_isolation,
            publisher=publisher,
            campaign_id=f"camp_cross_brand_denied_{suffix}",
            asset_id=f"asset_cross_brand_denied_{suffix}",
        )
    except SocialAmplifierDenied:
        pass
    else:
        raise SystemExit("Cross-brand Social workflow was not denied")
    if len(isolation_paperclip.list_tasks()) != before_denial:
        raise SystemExit("Cross-brand denial created Paperclip work")

    portal_path = Path("/etc/agency-os/operator-portal.json")
    portal = json.loads(portal_path.read_text())
    portal["bindings"] = [
        {"company_id": company_id, "brand_id": brand_id,
         "token_env": "PAPERCLIP_BOARD_API_KEY",
         "approval_ids": [core.approval["id"], social.approval["id"]]},
        {"company_id": isolation_id, "brand_id": "brand_agency_isolation",
         "token_env": "PAPERCLIP_BOARD_API_KEY",
         "approval_ids": [isolation_core.approval["id"]]},
    ]
    atomic_json(portal_path, portal)
    evidence = {
        "schema_version": "1.0",
        "status": "live_production",
        "verified_at": datetime.now(timezone.utc).isoformat(),
        "agency_os_commit": commit,
        "brand_id": brand_id,
        "company_id": company_id,
        "paperclip_authenticated": True,
        "buzz_authenticated": True,
        "provider_external_writes": False,
        "mock_publication_calls": publisher.calls,
        "core": {
            "campaign_id": f"camp_live_{suffix}",
            "task_count": len(core.tasks_by_role),
            "approval_id": core.approval["id"],
            "approval_status": core.approval["status"],
            "buzz_channel_id": core.records["buzz_decision_writeback"]["payload"]["buzz_channel_id"],
            "paperclip_cost_event_recorded": True,
        },
        "social": {
            "campaign_id": f"camp_live_social_{suffix}",
            "task_count": len(social.tasks_by_role),
            "approval_id": social.approval["id"],
            "approval_status": social.approval["status"],
            "buzz_channel_id": social.records["buzz_decision_writeback"]["payload"]["buzz_channel_id"],
        },
        "isolation_brand": {
            "company_id": isolation_id,
            "brand_id": "brand_agency_isolation",
            "campaign_id": f"camp_isolation_{suffix}",
            "task_count": len(isolation_core.tasks_by_role),
            "approval_id": isolation_core.approval["id"],
            "approval_status": isolation_core.approval["status"],
            "cross_brand_social_denied": True,
            "denial_created_tasks": False,
            "paperclip_cost_event_recorded": False,
        },
    }
    atomic_json(
        Path("/var/lib/paperclip-appliance/agency-os-production.json"), evidence
    )
    subprocess.run(["systemctl", "restart", "agency-os-operator.service"], check=True)
    print("AGENCY OS LIVE ACCEPTANCE: PASS")


if __name__ == "__main__":
    main()
