#!/bin/sh
set -eu

iptables=/usr/sbin/iptables
subnet=172.30.0.0/24
for specification in \
  "-C DOCKER-USER -s $subnet -j PAPERCLIP-EGRESS" \
  "-C PAPERCLIP-EGRESS -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN" \
  "-C PAPERCLIP-EGRESS -d 10.0.0.0/8 -j REJECT --reject-with icmp-net-unreachable" \
  "-C PAPERCLIP-EGRESS -d 100.64.0.0/10 -j REJECT --reject-with icmp-net-unreachable" \
  "-C PAPERCLIP-EGRESS -d 127.0.0.0/8 -j REJECT --reject-with icmp-net-unreachable" \
  "-C PAPERCLIP-EGRESS -d 169.254.0.0/16 -j REJECT --reject-with icmp-net-unreachable" \
  "-C PAPERCLIP-EGRESS -d 172.16.0.0/12 -j REJECT --reject-with icmp-net-unreachable" \
  "-C PAPERCLIP-EGRESS -d 192.168.0.0/16 -j REJECT --reject-with icmp-net-unreachable" \
  "-C INPUT -s $subnet -j PAPERCLIP-HOST" \
  "-C PAPERCLIP-HOST -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT" \
  "-C PAPERCLIP-HOST -p tcp --dport 3100 -j ACCEPT" \
  "-C PAPERCLIP-HOST -j REJECT --reject-with icmp-port-unreachable"
do
  # These tokens are fixed internally and never contain operator input.
  # shellcheck disable=SC2086
  $iptables -w $specification
done

expected_egress=$(printf '%s\n' \
  '-N PAPERCLIP-EGRESS' \
  '-A PAPERCLIP-EGRESS -m conntrack --ctstate RELATED,ESTABLISHED -j RETURN' \
  '-A PAPERCLIP-EGRESS -d 10.0.0.0/8 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -d 100.64.0.0/10 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -d 127.0.0.0/8 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -d 169.254.0.0/16 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -d 172.16.0.0/12 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -d 192.168.0.0/16 -j REJECT --reject-with icmp-net-unreachable' \
  '-A PAPERCLIP-EGRESS -j RETURN')
expected_host=$(printf '%s\n' \
  '-N PAPERCLIP-HOST' \
  '-A PAPERCLIP-HOST -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT' \
  '-A PAPERCLIP-HOST -p tcp -m tcp --dport 3100 -j ACCEPT' \
  '-A PAPERCLIP-HOST -j REJECT --reject-with icmp-port-unreachable')
test "$($iptables -w -S PAPERCLIP-EGRESS)" = "$expected_egress"
test "$($iptables -w -S PAPERCLIP-HOST)" = "$expected_host"
docker_hook="-A DOCKER-USER -s $subnet -j PAPERCLIP-EGRESS"
host_hook="-A INPUT -s $subnet -j PAPERCLIP-HOST"
test "$($iptables -w -S DOCKER-USER | sed -n '2p')" = "$docker_hook"

# Tailscale installs its own narrow INPUT hook at position one.  Permit that
# one reviewed predecessor while keeping the Paperclip source-subnet hook ahead
# of UFW and every other host rule.  Traffic from the Docker subnet does not
# arrive on tailscale0 and must fall through ts-input into PAPERCLIP-HOST.
first_input=$($iptables -w -S INPUT | sed -n '2p')
case "$first_input" in
  "$host_hook") ;;
  '-A INPUT -j ts-input')
    test "$($iptables -w -S INPUT | sed -n '3p')" = "$host_hook"
    $iptables -w -C ts-input -i tailscale0 -j ACCEPT
    if $iptables -w -S ts-input | grep -F -- "$subnet" >/dev/null; then
      echo "Tailscale INPUT chain unexpectedly names the Paperclip subnet" >&2
      exit 1
    fi
    ;;
  *)
    echo "unexpected rule before the Paperclip INPUT hook: $first_input" >&2
    exit 1
    ;;
esac

image=$(sed -n 's/^HERMES_DOCKER_IMAGE=//p' /opt/paperclip/integration/build/appliance.lock)
/usr/bin/docker run --rm --network paperclip-hermes \
  --cap-drop ALL --security-opt no-new-privileges \
  --read-only --tmpfs /tmp:rw,noexec,nosuid,size=8m \
  --volume /opt/paperclip/ops/paperclip-network-probe.py:/probe.py:ro \
  --entrypoint python "$image" /probe.py
