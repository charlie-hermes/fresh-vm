#!/bin/sh
set -eu

case "${1:-}" in
  delegation)
    pattern='^(\[done\][[:space:]]*)?┊[[:space:]]+🔀[[:space:]]+delegate[[:space:]]+2x:.*[[:space:]][[:space:]][0-9]+\.[0-9]s[[:space:]]*$'
    ;;
  web-search)
    pattern='^(\[done\][[:space:]]*)?┊[[:space:]]+⚡[[:space:]]+web_searc[[:space:]].*[[:space:]][[:space:]][0-9]+\.[0-9]s[[:space:]]*$'
    ;;
  *)
    echo "usage: paperclip-tool-completion-check {delegation|web-search}" >&2
    exit 64
    ;;
esac

# Hermes adds every failure indicator after the duration. Requiring the
# duration at end-of-line excludes [error], [exit N], and detailed failures.
LC_ALL=C.UTF-8 grep -Eq "$pattern"
