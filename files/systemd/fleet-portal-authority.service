[Unit]
Description=Fleet portal protected authority
After=local-fs.target

[Service]
Type=simple
User=fleet-authority
Group=fleet-authority
SupplementaryGroups=fleet-authority-client fleet-ingest
EnvironmentFile=/etc/agency-os/fleet-authority.env
WorkingDirectory=/opt/agency-os/current
ExecStart=/usr/bin/python3 -m agency_os.fleet_portal_authority_host --database /var/lib/agency-os/fleet-portal.sqlite3 --tenant-authority-database /var/lib/agency-os/fleet-tenancy.sqlite3 --brand-intelligence-database /var/lib/agency-os/fleet-brand-intelligence.sqlite3 --review-spool /var/spool/agency-os/fleet-ingest/review --socket /run/agency-os/fleet-authority.sock
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=agency-os
RuntimeDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/agency-os /run/agency-os /var/spool/agency-os/fleet-ingest/review
PrivateDevices=true
ProtectProc=invisible
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
