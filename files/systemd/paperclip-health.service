[Unit]
Description=Validate Paperclip API, Docker network, and disk headroom
After=paperclip.service docker.service
Requires=paperclip.service docker.service

[Service]
Type=oneshot
User=root
Group=root
SupplementaryGroups=docker
Environment=HOME=/var/lib/paperclip
ExecStart=/opt/paperclip/ops/paperclip-health.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/paperclip
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
