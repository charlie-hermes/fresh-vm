[Unit]
Description=Paperclip Hermes Docker egress and host-access policy
Requires=docker.service
After=docker.service
Before=paperclip.service
PartOf=docker.service

[Service]
Type=oneshot
ExecStart=/opt/paperclip/ops/paperclip-network-policy
RemainAfterExit=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
