#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

test "$(id -u)" -eq 0 || { echo "root required" >&2; exit 77; }
auth_source=${1:-}
env_source=${2:-}
test -f "$auth_source" && test ! -L "$auth_source" ||
  { echo "usage: paperclip-hermes-credential-install AUTH_JSON [ENV_FILE]" >&2; exit 64; }
jq -e '
  type == "object" and
  (.version | type == "number") and
  (.providers | type == "object") and
  (.active_provider | type == "string") and
  (.credential_pool | type == "object")
' "$auth_source" >/dev/null
if [ -n "$env_source" ]; then
  test -f "$env_source" && test ! -L "$env_source" ||
    { echo "environment seed must be a regular file" >&2; exit 64; }
fi

profiles=(operations research production qa)
for slug in "${profiles[@]}"; do
  home=/var/lib/paperclip/agents/$slug/home
  test -d "$home" || { echo "missing profile: $slug" >&2; exit 69; }
done
for slug in "${profiles[@]}"; do
  home=/var/lib/paperclip/agents/$slug/home
  install -o paperclip -g paperclip -m 0600 "$auth_source" "$home/auth.json"
  if [ -n "$env_source" ]; then
    install -o paperclip -g paperclip -m 0600 "$env_source" "$home/.env"
  fi
  rm -f -- "$home/CREDENTIAL_REQUIRED"
done

if [ -f /etc/paperclip/operator.env ] && [ -f /etc/paperclip/hermes-agent-ids.json ]; then
  set -a
  . /etc/paperclip/operator.env
  set +a
  jq -r '.[]' /etc/paperclip/hermes-agent-ids.json | while IFS= read -r agent_id; do
    curl --fail --silent --show-error --max-time 10 \
      -X POST -H "Authorization: Bearer $PAPERCLIP_BOARD_API_KEY" \
      "http://172.30.0.1:3100/api/agents/$agent_id/resume" >/dev/null
  done
fi
install -d -o root -g root -m 0700 /var/lib/paperclip-appliance
date -u +%Y-%m-%dT%H:%M:%SZ > /var/lib/paperclip-appliance/hermes-credential-installed
chmod 0600 /var/lib/paperclip-appliance/hermes-credential-installed
echo "Hermes credential installed into four isolated profiles"
