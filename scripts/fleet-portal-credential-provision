#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
umask 077

test "$(id -u)" -eq 0 || { echo "root required" >&2; exit 77; }
target=/etc/agency-os/fleet-command-paperclip.env
if test -s "$target"; then
  test "$(grep -Ec '^(PAPERCLIP_BASE_URL|PAPERCLIP_BOARD_TOKEN|PAPERCLIP_COMPANY_ID|FLEET_PORTAL_BRAND_ID)=' "$target")" -eq 4 || {
    echo "existing Fleet command-worker credential is incomplete" >&2
    exit 65
  }
  exit 0
fi
test -s /etc/paperclip/operator.env && test -s /etc/paperclip/company-id || {
  echo "Paperclip operator bootstrap is incomplete" >&2
  exit 69
}
# shellcheck disable=SC1091
. /etc/paperclip/operator.env
base=http://172.30.0.1:3100
api=$base/api
cookie=$(mktemp)
body=$(mktemp)
trap 'rm -f -- "$cookie" "$body"' EXIT HUP INT TERM
jq -n --arg email "$PAPERCLIP_OPERATOR_EMAIL" --arg password "$PAPERCLIP_OPERATOR_PASSWORD"   '{email:$email,password:$password}' |
  curl --fail --silent --show-error --max-time 10 -c "$cookie"     -H 'Content-Type: application/json' -H "Origin: $base"     --data-binary @- "$api/auth/sign-in/email" >"$body"
jq -e '.user.id | type == "string"' "$body" >/dev/null
curl --fail --silent --show-error --max-time 10 -b "$cookie"   -H 'Content-Type: application/json' -H "Origin: $base"   --data '{"name":"fleet-portal-command-worker","expiresAt":null}'   "$api/board-api-keys" >"$body"
token=$(jq -er '.token' "$body")
key_id=$(jq -er '.id' "$body")
company_id=$(tr -d '\n' </etc/paperclip/company-id)
temporary=$(mktemp /etc/agency-os/.fleet-command-paperclip.XXXXXX)
printf '%s\n'   "PAPERCLIP_BASE_URL=$base"   "PAPERCLIP_BOARD_TOKEN=$token"   "PAPERCLIP_BOARD_API_KEY_ID=$key_id"   "PAPERCLIP_COMPANY_ID=$company_id"   'FLEET_PORTAL_BRAND_ID=brand_fleet' >"$temporary"
install -o root -g fleet-command -m 0640 "$temporary" "$target"
rm -f -- "$temporary"
unset PAPERCLIP_OPERATOR_EMAIL PAPERCLIP_OPERATOR_PASSWORD PAPERCLIP_BOARD_API_KEY token
