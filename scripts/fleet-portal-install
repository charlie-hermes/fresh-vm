#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export DEBIAN_FRONTEND=noninteractive
umask 077

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck disable=SC1091
. "$repo/appliance.lock"
test "$(id -u)" -eq 0 || { echo "root required" >&2; exit 77; }

apt-get update
apt-get install --yes \
  "clamav=$CLAMAV_PACKAGE_VERSION" \
  "poppler-utils=$POPPLER_UTILS_PACKAGE_VERSION" \
  "tesseract-ocr=$TESSERACT_OCR_PACKAGE_VERSION"

getent group fleet-portal >/dev/null || groupadd --system fleet-portal
getent group fleet-ingest >/dev/null || groupadd --system fleet-ingest
id fleet-portal >/dev/null 2>&1 || useradd --system --gid fleet-portal \
  --groups fleet-ingest --home-dir /nonexistent --shell /usr/sbin/nologin fleet-portal
id fleet-ingest >/dev/null 2>&1 || useradd --system --gid fleet-ingest \
  --home-dir /nonexistent --shell /usr/sbin/nologin fleet-ingest
usermod --append --groups fleet-ingest fleet-portal

"$repo/scripts/agency-os-install" >/dev/null
install -d -o root -g root -m 0700 /etc/agency-os /var/lib/agency-os
install -d -o root -g root -m 0755 \
  /opt/paperclip/integration/docs /opt/paperclip/integration/build/locks
install -d -o root -g root -m 0755 /var/spool/agency-os
install -d -o fleet-ingest -g fleet-ingest -m 0750 /var/spool/agency-os/fleet-ingest
install -d -o fleet-portal -g fleet-ingest -m 2770 /var/spool/agency-os/fleet-ingest/incoming
for directory in review processed rejected; do
  install -d -o fleet-ingest -g fleet-ingest -m 0700 "/var/spool/agency-os/fleet-ingest/$directory"
done

portal_uid=$(id -u fleet-portal)
portal_gid=$(getent group fleet-portal | cut -d: -f3)
mutation_disabled=0
if test -f /etc/agency-os/fleet-authority.env; then
  mutation_disabled=$(awk -F= '$1=="FLEET_PORTAL_MUTATIONS_DISABLED" {print $2}' \
    /etc/agency-os/fleet-authority.env)
  case "$mutation_disabled" in 0|1) ;; *) mutation_disabled=0;; esac
fi
temporary=$(mktemp /etc/agency-os/.fleet-authority.XXXXXX)
printf 'FLEET_AUTHORITY_ALLOWED_UIDS=%s\nFLEET_AUTHORITY_SOCKET_GID=%s\nFLEET_PORTAL_MUTATIONS_DISABLED=%s\n' \
  "$portal_uid" "$portal_gid" "$mutation_disabled" >"$temporary"
install -o root -g root -m 0600 "$temporary" /etc/agency-os/fleet-authority.env
rm -f -- "$temporary"

if test -s /etc/paperclip/company-id; then
  company_id=$(tr -d '\n' </etc/paperclip/company-id)
  temporary=$(mktemp /etc/agency-os/.fleet-command-worker.XXXXXX)
  printf '%s\n' \
    'PAPERCLIP_BASE_URL=http://172.30.0.1:3100' \
    "PAPERCLIP_COMPANY_ID=$company_id" \
    'FLEET_PORTAL_BRAND_ID=brand_fleet' >"$temporary"
  install -o root -g root -m 0600 "$temporary" /etc/agency-os/fleet-command-worker.env
  rm -f -- "$temporary"
fi
if test -s /etc/paperclip/operator.env && test -s /etc/paperclip/company-id; then
  "$repo/scripts/fleet-portal-paperclip-sync" >/dev/null
fi

for unit in "$repo"/files/systemd/fleet-portal-*.service \
  "$repo"/files/systemd/fleet-ingest-worker.service; do
  install -o root -g root -m 0644 "$unit" "/etc/systemd/system/$(basename "$unit")"
done
install -o root -g root -m 0755 "$repo/scripts/fleet-portal-configure" \
  /usr/local/sbin/fleet-portal-configure
install -o root -g root -m 0755 "$repo/scripts/fleet-portal-install" \
  /usr/local/sbin/fleet-portal-install
install -o root -g root -m 0755 "$repo/scripts/fleet-portal-mutations" \
  /usr/local/sbin/fleet-portal-mutations
install -o root -g root -m 0755 "$repo/scripts/fleet-portal-paperclip-sync" \
  /usr/local/sbin/fleet-portal-paperclip-sync
install -o root -g root -m 0644 "$repo/docs/fleet-portal-operations.md" \
  /opt/paperclip/integration/docs/fleet-portal-operations.md
install -o root -g root -m 0644 "$repo/appliance.lock" \
  /opt/paperclip/integration/build/appliance.lock
install -o root -g root -m 0644 "$repo/locks/installed-assets.tsv" \
  /opt/paperclip/integration/build/locks/installed-assets.tsv
install -o root -g root -m 0755 "$repo/verify.sh" \
  /usr/local/sbin/paperclip-appliance-verify
systemctl daemon-reload
systemctl enable --now fleet-portal-authority.service fleet-ingest-worker.service
if test -s /etc/paperclip/operator.env && test -s /etc/agency-os/fleet-command-worker.env; then
  systemctl enable --now fleet-portal-command-worker.service
fi
if test -s /etc/agency-os/fleet-portal.env; then
  systemctl enable --now fleet-portal-web.service
fi
echo "Fleet portal runtime installed; configure external identity with fleet-portal-configure."
