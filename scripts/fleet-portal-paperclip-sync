#!/usr/bin/python3
"""Idempotently install the bounded Fleet G2.6 task graph in Paperclip."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path
from typing import Any


COMPANY_ID = "d7e2e389-c7ad-486e-87ca-482e4ec6216d"
TASK_KEYS = ("FL2-80A", "FL2-80B", "FL2-80C", "FL2-80D")
API = "/opt/paperclip/ops/paperclip-board-api"
TEMPLATE = Path("/opt/agency-os/current/config/paperclip-generation2-template.json")


def api(method: str, path: str, payload: dict[str, Any] | None = None) -> Any:
    command = [API, method, path]
    encoded = None
    if payload is not None:
        command.append("-")
        encoded = json.dumps(payload, sort_keys=True, separators=(",", ":"))
    result = subprocess.run(
        command, input=encoded, check=True, capture_output=True, text=True,
        timeout=120,
    )
    return json.loads(result.stdout)


def issue_key(issue: dict[str, Any]) -> str:
    return str(issue.get("title", "")).split(" — ", 1)[0]


def unique_by_key(issues: list[dict[str, Any]], key: str) -> dict[str, Any] | None:
    matches = [issue for issue in issues if issue_key(issue) == key]
    if len(matches) > 1:
        raise SystemExit(f"Paperclip has duplicate {key} issues")
    return matches[0] if matches else None


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--verify-only", action="store_true")
    args = parser.parse_args()
    if os.geteuid() != 0:
        raise SystemExit("root required")
    if not TEMPLATE.is_file():
        raise SystemExit("the pinned G2.6 Paperclip template is missing")
    template = json.loads(TEMPLATE.read_text(encoding="utf-8"))
    entries = {item["key"]: item for item in template["issues"]}
    issues = api("GET", f"/companies/{COMPANY_ID}/issues")
    if not isinstance(issues, list):
        raise SystemExit("Paperclip issue projection is invalid")
    root = unique_by_key(issues, "FL2-80")
    if root is None:
        raise SystemExit("the human-created FL2-80 programme-control issue is missing")
    project_id = root.get("projectId")
    goal_id = root.get("goalId")
    if not isinstance(project_id, str) or not isinstance(goal_id, str):
        raise SystemExit("FL2-80 is not bound to the Fleet Generation 2 programme")

    for key in TASK_KEYS:
        entry = entries[key]
        dependency_ids: list[str] = []
        for dependency_key in entry["depends_on"]:
            dependency = unique_by_key(issues, dependency_key)
            if dependency is None:
                raise SystemExit(f"Paperclip dependency {dependency_key} is missing")
            dependency_ids.append(str(dependency["id"]))
        issue = unique_by_key(issues, key)
        if issue is None:
            if args.verify_only:
                raise SystemExit(f"Paperclip {key} is missing")
            description = (
                f"Gate {entry['gate']}. G2.6 acceptance is dependency-and-evidence controlled.\n\n"
                "Acceptance evidence:\n- " + "\n- ".join(entry["acceptance"]) +
                "\n\nSource: docs/fleet-client-portal-g2.6-enterprise-plan.md"
            )
            issue = api(
                "POST", f"/companies/{COMPANY_ID}/issues",
                {
                    "title": f"{key} — {entry['title']}",
                    "description": description,
                    "status": "backlog", "priority": entry["priority"],
                    "workMode": "standard", "parentId": root["id"],
                    "projectId": project_id, "goalId": goal_id,
                    "blockedByIssueIds": dependency_ids,
                    "idempotencyKey": f"fleet-g26-{key.lower()}-v1",
                    "allowDuplicate": False,
                },
            )
            issues = api("GET", f"/companies/{COMPANY_ID}/issues")
        detail = api("GET", f"/issues/{issue['id']}")
        actual_dependencies = sorted(item["id"] for item in detail.get("blockedBy", []))
        if detail.get("parentId") != root["id"] or actual_dependencies != sorted(dependency_ids):
            raise SystemExit(f"Paperclip {key} hierarchy or dependency drift")

    fl90 = unique_by_key(issues, "FL2-90")
    final_gate = unique_by_key(issues, "FL2-80D")
    if fl90 is None or final_gate is None:
        raise SystemExit("FL2-90 or FL2-80D is missing")
    fl90_detail = api("GET", f"/issues/{fl90['id']}")
    fl90_dependencies = [item["id"] for item in fl90_detail.get("blockedBy", [])]
    if fl90_dependencies != [final_gate["id"]]:
        if args.verify_only:
            raise SystemExit("FL2-90 is not blocked by FL2-80D")
        api(
            "PATCH", f"/issues/{fl90['id']}",
            {"blockedByIssueIds": [final_gate["id"]]},
        )
        fl90_detail = api("GET", f"/issues/{fl90['id']}")
        if [item["id"] for item in fl90_detail.get("blockedBy", [])] != [final_gate["id"]]:
            raise SystemExit("FL2-90 dependency did not converge on FL2-80D")
    state = "verified" if args.verify_only else "synchronized"
    print(f"Fleet G2.6 Paperclip task graph {state}.")


if __name__ == "__main__":
    main()
