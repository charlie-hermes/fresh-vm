#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

state=/var/lib/paperclip-appliance
pending=$state/pending
bootstrap=$state/bootstrap
base=http://172.30.0.1:3100
api=$base/api
template=/opt/paperclip/integration/paperclip
factory=/usr/local/sbin/paperclip-hermes-profile-init
factory_assets=/opt/paperclip/integration/factory
credential_installer=/usr/local/sbin/paperclip-hermes-credential-install
# shellcheck disable=SC1091
. /opt/paperclip/integration/build/appliance.lock

test "$(id -u)" -eq 0 || { echo "root required" >&2; exit 77; }
test -e "$pending" || exit 0
test -e "$state/precomplete" || { echo "firstboot pre-stage incomplete" >&2; exit 1; }
exec 9>"$state/finalize.lock"
flock -n 9 || exit 0
set -a
. "$bootstrap/admin.env"
set +a

cookie=$(mktemp)
body=$(mktemp)
trap 'rm -f "$cookie" "$body"' EXIT HUP INT TERM

for _ in $(seq 1 120); do
  if curl --fail --silent --max-time 2 "$api/health" |
      jq -e '.status == "ok"' >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
curl --fail --silent --show-error --max-time 5 "$api/health" >/dev/null

login() {
  jq -n --arg e "$PAPERCLIP_OPERATOR_EMAIL" --arg p "$PAPERCLIP_OPERATOR_PASSWORD" \
    '{email:$e,password:$p}' |
  curl --silent --show-error --max-time 10 -c "$cookie" \
    -H 'Content-Type: application/json' -H "Origin: $base" \
    --data-binary @- "$api/auth/sign-in/email" >"$body"
}
if ! login || ! jq -e '.user.id | type == "string"' "$body" >/dev/null 2>&1; then
  jq -n --arg e "$PAPERCLIP_OPERATOR_EMAIL" --arg p "$PAPERCLIP_OPERATOR_PASSWORD" \
    '{name:"Paperclip Administrator",email:$e,password:$p}' |
  curl --fail --silent --show-error --max-time 10 -c "$cookie" \
    -H 'Content-Type: application/json' -H "Origin: $base" \
    --data-binary @- \
    "$api/auth/sign-up/email" >"$body"
  jq -e '.user.id | type == "string"' "$body" >/dev/null
fi

claim_code=$(curl --silent --show-error --max-time 10 -o "$body" -w '%{http_code}' \
  -b "$cookie" -H 'Content-Type: application/json' -H "Origin: $base" \
  --data '{}' "$api/bootstrap/claim")
case "$claim_code" in 200|409) ;; *) cat "$body" >&2; exit 1;; esac

if [ ! -f /etc/paperclip/operator.env ]; then
  curl --fail --silent --show-error --max-time 10 -b "$cookie" \
    -H 'Content-Type: application/json' -H "Origin: $base" \
    --data '{"name":"appliance-operator","expiresAt":null}' \
    "$api/board-api-keys" >"$body"
  board_id=$(jq -er '.id' "$body")
  board_token=$(jq -er '.token' "$body")
  cat > /etc/paperclip/operator.env <<EOF
PAPERCLIP_OPERATOR_EMAIL=$PAPERCLIP_OPERATOR_EMAIL
PAPERCLIP_OPERATOR_PASSWORD=$PAPERCLIP_OPERATOR_PASSWORD
PAPERCLIP_BOARD_API_KEY=$board_token
PAPERCLIP_BOARD_API_KEY_ID=$board_id
EOF
  chmod 0600 /etc/paperclip/operator.env
fi
set -a
. /etc/paperclip/operator.env
set +a

api_call() {
  method=$1
  path=$2
  data=${3:-}
  if [ -n "$data" ]; then
    printf '%s' "$data" | /opt/paperclip/ops/paperclip-board-api "$method" "$path" -
  else
    /opt/paperclip/ops/paperclip-board-api "$method" "$path"
  fi
}

if [ ! -f /etc/paperclip/company-id ]; then
  company_name=$(cat /etc/paperclip/company-name)
  company_id=$(api_call GET /companies |
    jq -r --arg name "$company_name" '.[] | select(.name==$name) | .id' | head -n 1)
  if [ -z "$company_id" ]; then
    company_payload=$(jq -nc --arg name "$company_name" \
      '{name:$name,description:"Private Hermes/Paperclip client appliance"}')
    api_call POST /companies "$company_payload" >"$body"
    company_id=$(jq -er '.id' "$body")
  fi
  printf '%s\n' "$company_id" > /etc/paperclip/company-id
  chmod 0600 /etc/paperclip/company-id
else
  company_id=$(cat /etc/paperclip/company-id)
fi

create_agent() {
  slug=$1
  role_pack=$2
  name=$3
  role=$4
  title=$5
  reports_to=$6
  instructions=$7
  "$factory" "$slug" "$role_pack" >/dev/null
  agent_id=$(api_call GET "/companies/$company_id/agents" |
    jq -r --arg name "$name" '.[] | select(.name==$name) | .id' | head -n 1)
  if [ -z "$agent_id" ]; then
  payload=$(jq -n \
    --arg name "$name" --arg role "$role" --arg title "$title" \
    --arg cwd "/srv/paperclip/workspaces/$slug" \
    --arg home "/var/lib/paperclip/agents/$slug/home" \
    --arg hermesCommand "/opt/hermes-agent/$HERMES_COMMIT/venv/bin/hermes" \
    --arg reports "$reports_to" --arg roleId "$slug" \
    '{
      name:$name, role:$role, title:$title, adapterType:"hermes_local",
      adapterConfig:{
        cwd:$cwd, env:{HERMES_HOME:{type:"plain",value:$home}},
        hermesCommand:$hermesCommand,
        provider:"openai-codex", model:"gpt-5.6-sol",
        maxTurnsPerRun:40, timeoutSec:900, graceSec:20,
        persistSession:true, checkpoints:true, quiet:true, verbose:false,
        worktreeMode:false, extraArgs:["--pass-session-id"],
        paperclipApiUrl:"http://paperclip-host:3100",
        instructionsBundleMode:"managed", instructionsEntryFile:"AGENTS.md"
      },
      runtimeConfig:{heartbeat:{enabled:false,maxConcurrentRuns:1}},
      permissions:{canCreateAgents:false,canCreateSkills:false,canAssignTasks:false,
        trustPreset:"standard"},
      metadata:{agencyOsCoreRole:true,roleId:$roleId}
    } + (if $reports=="" then {} else {reportsTo:$reports} end)')
    api_call POST "/companies/$company_id/agents" "$payload" >"$body"
    agent_id=$(jq -er '.id' "$body")
  fi
  api_call PUT "/agents/$agent_id/instructions-bundle/file" \
    "$(jq -n --rawfile c "$instructions" \
      '{path:"AGENTS.md",content:$c,clearLegacyPromptTemplate:true}')" >/dev/null
  can_assign=false
  test "$slug" != agency-director || can_assign=true
  api_call PATCH "/agents/$agent_id/permissions" \
    "$(jq -nc --argjson assign "$can_assign" \
      '{canCreateAgents:false,canCreateSkills:false,canAssignTasks:$assign,
        trustPreset:"standard"}')" >/dev/null
  printf '%s\n' "$agent_id"
}

if [ ! -f /etc/paperclip/hermes-agent-ids.json ]; then
  director_id=$(create_agent agency-director agency-director \
    "Agency Director" ceo "Agency Director" "" \
    "$factory_assets/core-roles/agency-director/AGENTS.md")
  steward_id=$(create_agent brand-brief-steward brand-brief-steward \
    "Brand and Brief Steward" pm "Brand and Brief Steward" "$director_id" \
    "$factory_assets/core-roles/brand-brief-steward/AGENTS.md")
  strategist_id=$(create_agent search-content-strategist search-content-strategist \
    "Search and Content Strategist" researcher "Search and Content Strategist" \
    "$director_id" "$factory_assets/core-roles/search-content-strategist/AGENTS.md")
  producer_id=$(create_agent content-producer content-producer \
    "Content Producer" designer "Content Producer" "$director_id" \
    "$factory_assets/core-roles/content-producer/AGENTS.md")
  optimiser_id=$(create_agent search-answer-optimiser search-answer-optimiser \
    "Search and Answer Optimiser" researcher "Search and Answer Optimiser" \
    "$director_id" "$factory_assets/core-roles/search-answer-optimiser/AGENTS.md")
  editorial_id=$(create_agent editorial-integrity-qa editorial-integrity-qa \
    "Editorial Integrity QA" qa "Editorial Integrity QA" "$director_id" \
    "$factory_assets/core-roles/editorial-integrity-qa/AGENTS.md")
  publishing_id=$(create_agent publishing-operator publishing-operator \
    "Publishing Operator" devops "Publishing Operator" "$director_id" \
    "$factory_assets/core-roles/publishing-operator/AGENTS.md")
  growth_id=$(create_agent growth-intelligence-analyst growth-intelligence-analyst \
    "Growth Intelligence Analyst" researcher "Growth Intelligence Analyst" \
    "$director_id" "$factory_assets/core-roles/growth-intelligence-analyst/AGENTS.md")
  jq -n --arg director "$director_id" --arg steward "$steward_id" \
    --arg strategist "$strategist_id" --arg producer "$producer_id" \
    --arg optimiser "$optimiser_id" --arg editorial "$editorial_id" \
    --arg publishing "$publishing_id" --arg growth "$growth_id" \
    '{"agency-director":$director,"brand-brief-steward":$steward,
      "search-content-strategist":$strategist,"content-producer":$producer,
      "search-answer-optimiser":$optimiser,"editorial-integrity-qa":$editorial,
      "publishing-operator":$publishing,"growth-intelligence-analyst":$growth}' \
    > "$bootstrap/hermes-agent-ids.json"
  install -o root -g root -m 0600 \
    "$bootstrap/hermes-agent-ids.json" /etc/paperclip/hermes-agent-ids.json
  printf '%s\n' "$director_id" > /etc/paperclip/hermes-agent-id
  chmod 0600 /etc/paperclip/hermes-agent-id
fi

if [ -f /etc/paperclip-seed/hermes-auth.json ]; then
  env_arg=
  [ ! -f /etc/paperclip-seed/hermes.env ] || env_arg=/etc/paperclip-seed/hermes.env
  "$credential_installer" /etc/paperclip-seed/hermes-auth.json "$env_arg"
  rm -f -- /etc/paperclip-seed/hermes-auth.json /etc/paperclip-seed/hermes.env
elif [ -f "$state/hermes-credential-installed" ]; then
  jq -r '.[]' /etc/paperclip/hermes-agent-ids.json | while IFS= read -r agent_id; do
    api_call POST "/agents/$agent_id/resume" >/dev/null
  done
else
  jq -r '.[]' /etc/paperclip/hermes-agent-ids.json | while IFS= read -r agent_id; do
    api_call POST "/agents/$agent_id/pause" >/dev/null
  done
fi

jq '.auth.disableSignUp=true | .["$meta"].updatedAt=(now|todateiso8601)' \
  /var/lib/paperclip/instances/default/config.json > "$bootstrap/config.final.json"
install -o paperclip -g paperclip -m 0600 \
  "$bootstrap/config.final.json" /var/lib/paperclip/instances/default/config.json
systemctl restart paperclip.service
for _ in $(seq 1 90); do
  if curl --fail --silent --max-time 2 "$api/health" |
      jq -e '.status=="ok" and .bootstrapStatus=="ready" and
             .deploymentMode=="authenticated" and .deploymentExposure=="private"' \
      >/dev/null 2>&1; then
    break
  fi
  sleep 1
done
curl --fail --silent --show-error --max-time 5 "$api/health" |
  jq -e '.status=="ok" and .bootstrapStatus=="ready"' >/dev/null

install -d -o paperclip -g paperclip -m 0750 /var/lib/paperclip/acceptance-evidence
systemctl enable --now paperclip-health.timer \
  paperclip-soak-sample.timer >/dev/null

cat > /root/paperclip-firstboot-credentials <<EOF
Paperclip clone initialized: $(date -u +%Y-%m-%dT%H:%M:%SZ)
Instance ID: $PAPERCLIP_INSTANCE_ID
URL from this VM: http://172.30.0.1:3100
Administrator email: $PAPERCLIP_OPERATOR_EMAIL
Administrator password: $PAPERCLIP_OPERATOR_PASSWORD
Board API token: $PAPERCLIP_BOARD_API_KEY
Hermes credential: $([ -f "$state/hermes-credential-installed" ] && echo installed || echo REQUIRED)

If Hermes credential is REQUIRED, run:
  sudo paperclip-hermes-credential-install /secure/path/auth.json [/secure/path/hermes.env]
EOF
chmod 0600 /root/paperclip-firstboot-credentials

complete_tmp=$(mktemp "$state/.complete.XXXXXX")
date -u +%Y-%m-%dT%H:%M:%SZ >"$complete_tmp"
chmod 0600 "$complete_tmp"
mv -f "$complete_tmp" "$state/complete"
rm -f -- "$pending"
rm -rf -- "$bootstrap"
echo "Paperclip clone initialization complete"
