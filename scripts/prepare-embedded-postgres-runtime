#!/bin/bash
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin

paperclip_root=${1:?usage: prepare-embedded-postgres-runtime PAPERCLIP_ROOT}
lib_dir=$paperclip_root/node_modules/@embedded-postgres/linux-x64/native/lib

test -d "$lib_dir" ||
  { echo "missing embedded PostgreSQL native library directory: $lib_dir" >&2; exit 1; }

created=0
while IFS= read -r -d '' library; do
  name=${library##*/}
  if [[ ! $name =~ ^(lib.+\.so\.[0-9]+)\.[0-9]+(\.[0-9]+)?$ ]]; then
    continue
  fi

  alias_name=${BASH_REMATCH[1]}
  alias_path=$lib_dir/$alias_name
  if [ -e "$alias_path" ] || [ -L "$alias_path" ]; then
    if [ ! -L "$alias_path" ] ||
       [ "$(readlink -- "$alias_path")" != "$name" ]; then
      echo "unexpected embedded PostgreSQL library alias: $alias_path" >&2
      exit 1
    fi
    continue
  fi

  ln -s -- "$name" "$alias_path"
  created=$((created + 1))
done < <(find "$lib_dir" -maxdepth 1 -type f -print0 | LC_ALL=C sort -z)

echo "embedded PostgreSQL runtime aliases verified ($created created)"
